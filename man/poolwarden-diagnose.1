.nh
.TH "POOLWARDEN-DIAGNOSE" "1" "Nov 2026" "" ""

.SH NAME
poolwarden-diagnose - run the diagnosis rules


.SH SYNOPSIS
\fBpoolwarden diagnose [flags]\fP


.SH DESCRIPTION
run the diagnosis rules


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for diagnose

.PP
\fB--rule\fP=""
	run only this rule id

.PP
\fB--severity\fP=""
	minimum severity: info|warn|crit


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP="/etc/poolwarden.yaml"
	poolwarden config file

.PP
\fB--confirm\fP=""
	typed confirmation token for non-TTY use

.PP
\fB--force\fP[=false]
	override pre-flight WARN/NO-GO blocks

.PP
\fB--nagios\fP[=false]
	Nagios-style single-line output and exit codes

.PP
\fB--no-color\fP[=false]
	disable coloured output

.PP
\fB--operator\fP=""
	operator name (recorded in the audit log)

.PP
\fB-o\fP, \fB--output\fP="table"
	output format: table|wide|json

.PP
\fB--plan\fP[=false]
	control commands: print preflight+plan+token, do not execute

.PP
\fB--progress\fP[=false]
	control commands: emit NDJSON progress events on stderr

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--read-only\fP[=false]
	disable all control commands

.PP
\fB--ticket\fP=""
	change ticket id (audited when given)

.PP
\fB--yes\fP[=false]
	skip the plain yes/no prompt (never a typed confirmation)


.SH SEE ALSO
\fBpoolwarden(1)\fP
