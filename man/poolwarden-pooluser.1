.nh
.TH "POOLWARDEN-POOLUSER" "1" "Nov 2026" "" ""

.SH NAME
poolwarden-pooluser - manage pool_passwd users


.SH SYNOPSIS
\fBpoolwarden pooluser [flags]\fP


.SH DESCRIPTION
Manage pool_passwd entries. md5 passwords are computed in-process
(md5 of password+username — pg_md5 -p needs a TTY) and the file is
rewritten atomically; AES mode calls pg_enc -i  with the
password in a 0600 scratch file, never on argv or in the audit argv.
AES is chosen when existing pool_passwd entries are AES-prefixed.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for pooluser


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-c\fP, \fB--config\fP="/etc/poolwarden.yaml"
	poolwarden config file

.PP
\fB--confirm\fP=""
	typed confirmation token for non-TTY use

.PP
\fB--force\fP[=false]
	override pre-flight WARN/NO-GO blocks

.PP
\fB--nagios\fP[=false]
	Nagios-style single-line output and exit codes

.PP
\fB--no-color\fP[=false]
	disable coloured output

.PP
\fB--operator\fP=""
	operator name (recorded in the audit log)

.PP
\fB-o\fP, \fB--output\fP="table"
	output format: table|wide|json

.PP
\fB--plan\fP[=false]
	control commands: print preflight+plan+token, do not execute

.PP
\fB--progress\fP[=false]
	control commands: emit NDJSON progress events on stderr

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	suppress non-essential output

.PP
\fB--read-only\fP[=false]
	disable all control commands

.PP
\fB--ticket\fP=""
	change ticket id (audited when given)

.PP
\fB--yes\fP[=false]
	skip the plain yes/no prompt (never a typed confirmation)


.SH SEE ALSO
\fBpoolwarden(1)\fP, \fBpoolwarden-pooluser-add(1)\fP, \fBpoolwarden-pooluser-list(1)\fP, \fBpoolwarden-pooluser-passwd(1)\fP, \fBpoolwarden-pooluser-remove(1)\fP
