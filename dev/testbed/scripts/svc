#!/bin/bash
# svc — systemctl stand-in for the test bed (no systemd in containers).
# usage: svc <start|stop|restart|status> pgpool-II|postgresql
ACT=$1
UNIT=$2
PGDATA=/var/lib/postgresql/18/main
PGBIN=/usr/lib/postgresql/18/bin

case "$UNIT" in
  pgpool-II|pgpool)
    PGP="pgpool -f /etc/pgpool-II/pgpool.conf"
    case "$ACT" in
      start)   $PGP ;;
      stop)    pkill -INT -x pgpool ;;                    # SIGINT = fast shutdown
      restart) pkill -INT -x pgpool; sleep 2; $PGP ;;
      status)  n=$(ps -eo comm=,stat= | awk '$1=="pgpool" && $2 !~ /Z/' | wc -l)
               echo "pgpool processes: $n"; [ "$n" -gt 0 ] ;;
      *) echo "svc: bad action" >&2; exit 2;;
    esac
    ;;
  postgresql|postgres|pg)
    pgctl() { su postgres -c "$PGBIN/pg_ctl -D $PGDATA $1"; }
    case "$ACT" in
      start)   pgctl "-w -t 90 -l /tmp/pg-svc.log start" ;;
      stop)    pgctl "-w -t 60 -m fast stop" ;;
      restart) pgctl "-w -t 90 -m fast -l /tmp/pg-svc.log restart" ;;
      status)  pgctl status ;;
      *) echo "svc: bad action" >&2; exit 2;;
    esac
    ;;
  *) echo "svc: unknown unit $UNIT" >&2; exit 1;;
esac
