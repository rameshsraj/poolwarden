enable_pool_hba = on
pool_passwd = '/etc/pgpool-II/pool_passwd'
authentication_timeout = 60
logging_collector = on
log_directory = '/var/log/pgpool-II'
log_filename = 'pgpool-%Y-%m-%d_%H%M%S.log'
log_line_prefix = '%m: %a pid %p: '
health_check_period = 10
health_check_user = 'pgpool'
health_check_password = 'pgpool'
health_check_database = 'postgres'
health_check_max_retries = 3
health_check_retry_delay = 2
sr_check_period = 5
sr_check_user = 'pgpool'
sr_check_password = 'pgpool'
sr_check_database = 'postgres'
recovery_user = 'postgres'
recovery_password = 'pgpool'
recovery_1st_stage_command = 'recovery_1st_stage.sh'
pgpool_remote_start = 'pgpool_remote_start.sh'
failover_command = '/etc/pgpool-II/failover.sh %d %h %p %D %m %H %M %P %r %R'
follow_primary_command = '/etc/pgpool-II/follow_primary.sh %d %h %p %D %m %H %M %P %r %R'
failover_when_quorum_exists = on
failover_require_consensus = on
allow_multiple_failover_requests_from_node = off
use_watchdog = on
wd_priority = 1
delegate_ip = '@VIP@'
if_up_cmd = '/usr/sbin/ip addr add @VIP@/24 dev eth0 label eth0:0'
if_down_cmd = '/usr/sbin/ip addr del @VIP@/24 dev eth0'
arping_cmd = '@ARPING@'
wd_lifecheck_method = 'heartbeat'
wd_interval = 5
wd_heartbeat_keepalive = 2
wd_heartbeat_deadtime = 15
